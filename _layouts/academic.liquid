<!doctype html>
<html lang="en" data-appearance="academic">
<head>
  {% include academic-head.liquid %}
</head>
<body class="academic-site">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="academic-shell">
    {% include academic-header.liquid %}
    <main id="main">
      <section class="academic-hero" aria-labelledby="profile-title">
        <div class="academic-intro">
          <p class="eyebrow">WORLD MODELS · GENERATIVE AI</p>
          <h1 id="profile-title">Tao Hu <span lang="zh">胡涛</span></h1>
          <p class="academic-position">Full Professor<br>Huazhong University of Science and Technology</p>
          <p class="academic-lead">World models for interactive, closed-loop simulation.</p>
          <p>I am a Full Professor at HUST and lead <a href="https://taohu.me/lab/">VIBE Lab</a>. My research centers on world models: learning geometric and semantic representations, modeling how environments evolve, and generating controllable future states.</p>
          <p>I received my Ph.D. from the University of Amsterdam, advised by Cees G. M. Snoek and Pascal Mettes, and was a postdoctoral researcher in Björn Ommer’s lab at LMU Munich.</p>
          <div class="academic-topics"><span>World models</span><span>Diffusion & flow matching</span></div>
          <div class="academic-actions"><a class="primary-link" href="https://taohu.me/lab/">Explore VIBE Lab ↗</a><a href="{{ '/publications/' | relative_url }}">All publications →</a><a href="#join">Join the group →</a></div>
        </div>
        <aside class="academic-profile" aria-label="Profile and contact">
          <img class="academic-portrait" src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Tao Hu" width="3072" height="4080">
          <div class="academic-profile-copy"><h2>Tao Hu · 胡涛</h2><p>Full Professor · HUST<br>VIBE Lab</p>
            <div class="academic-profile-links"><a href="https://scholar.google.com/citations?user=EchdyZEAAAAJ">Google Scholar ↗</a><a href="https://github.com/dongzhuoyao">GitHub ↗</a><a href="mailto:taohu620@gmail.com">Email ↗</a><a href="https://cal.com/hu-tao-leakvj/30min">Book a meeting ↗</a><a href="https://www.xiaohongshu.com/user/profile/67af6461000000000e01ef10">Rednote 小红书 ↗</a></div>
          </div>
        </aside>
      </section>
      <section id="research-keywords" class="academic-section academic-panel" aria-labelledby="keywords-title">
        <h2 id="keywords-title">Research Keywords</h2>
        <ul class="research-keywords">
          <li>Memory in World Model</li>
          <li>Efficiency in World Model</li>
          <li>Multiplayer World Models</li>
          <li>Rolling-Based, Continuation-Based World Model</li>
          <li>Loop Transformer</li>
          <li>Tokenizer-Free</li>
          <li>Continuous Discrete Diffusion</li>
          <li>Weight-Space Programming</li>
        </ul>
      </section>
      <section id="join" class="academic-section join-panel" aria-labelledby="join-title">
        <div><p class="eyebrow">JOIN VIBE LAB</p><h2 id="join-title" lang="zh">2028 级研究生招生</h2><p lang="zh">招收保研/推免硕士研究生 4 人、博士研究生 2 人，欢迎与我联系！</p></div><a class="primary-link" href="mailto:taohu620+application@gmail.com">Get in touch →</a>
      </section>
      <section id="news" class="academic-section academic-panel" aria-labelledby="news-title">
        <div class="section-heading"><div><p class="eyebrow">LATEST UPDATES</p><h2 id="news-title">News</h2></div><a href="{{ '/news/' | relative_url }}">All news →</a></div>
        {% include news.liquid limit=true %}
      </section>
      <section id="papers" class="academic-section academic-panel" aria-label="Recent preprints">
        <p class="eyebrow">PAPERS</p>
        <div class="academic-preprints">{{ page.recent_preprints | markdownify }}</div>
        <a class="section-more" href="{{ '/publications/' | relative_url }}">View the complete publication list →</a>
      </section>
      <section id="background" class="academic-section academic-panel" aria-labelledby="background-title">
        <p class="eyebrow">BACKGROUND</p><h2 id="background-title">Experience</h2>
        <div class="experience-content">
          <div><h3>Appointments</h3><dl class="academic-timeline">
            <div><dt>Apr 2026–present</dt><dd><strong>Full Professor · HUST</strong><span>Generative artificial intelligence research.</span></dd></div>
            <div><dt>Sep 2026–present</dt><dd><strong>Chief Technical Expert · Dongfeng Motor R&D Institute</strong><span>Part-time · World models and interactive closed-loop simulation.</span></dd></div>
            <div><dt>Nov 2023–Nov 2025</dt><dd><strong>Postdoctoral Researcher · LMU Munich</strong><span>Ommer-Lab · Björn Ommer.</span></dd></div>
            <div><dt>2018–2023</dt><dd><strong>Ph.D. Researcher · University of Amsterdam</strong><span>VISLAB · Cees G. M. Snoek and Pascal Mettes.</span></dd></div>
          </dl>
          <h3 class="experience-subheading">Industry internships</h3>
          <dl class="academic-timeline">
            <div><dt>Jun 2020–Oct 2020</dt><dd><strong>Amazon · AWS Rekognition</strong><span class="experience-role">Applied Scientist Intern</span><span>Semi-supervised and few-shot learning.</span></dd></div>
            <div><dt>Jul 2017–May 2018</dt><dd><strong>Megvii Face++</strong><span class="experience-role">Research Intern</span><span>Human pose estimation.</span></dd></div>
          </dl>
          <p class="background-note">Earlier research internship at Xiaomi (2017).</p></div>
        </div>
      </section>
      <section id="service" class="academic-section academic-panel" aria-labelledby="community-title">
        <p class="eyebrow">ACADEMIC COMMUNITY</p><h2 id="community-title">Service</h2>
        <dl class="academic-service">
          {% for group in site.data.academic_service %}
            <div><dt>{{ group.title }}</dt><dd><ul>{% for item in group.items %}<li>{{ item }}</li>{% endfor %}</ul></dd></div>
          {% endfor %}
        </dl>
      </section>
      <section class="academic-section academic-panel academic-activity" aria-label="Activity and more links">
        {% include home-activity.liquid %}
      </section>
      {{ content }}
    </main>
    {% include academic-footer.liquid %}
  </div>
  <!-- Preserve the existing visitor counter. -->
  <div style="display:none;">
    <script type="text/javascript" id="clustrmaps" src="//cdn.clustrmaps.com/map_v2.js?cl=ffffff&w=a&t=n&d=21CLf19jYJsPiUe2kjErKACvUCh1zZ2lnWcRCsPJRa4"></script>
  </div>
</body>
</html>
